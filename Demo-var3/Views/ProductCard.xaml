<UserControl x:Class="Demo_var3.Views.ProductCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Demo_var3.Views"
             mc:Ignorable="d" 
             Height="auto"
             Width="auto"
             FontFamily="Calibri"
             Background="{Binding Background}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <Image Source="{Binding Image}" Grid.Column="0" Width="auto" Margin="10 0"/>

        <StackPanel Grid.Column="1" Grid.RowSpan="2">
            <TextBlock TextWrapping="Wrap" FontWeight="Bold">
                <Run Text="{Binding Category}"/>
                <Run Text=" | "/>
                <Run Text="{Binding Name}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Text="{Binding Description}"/>
            <TextBlock TextWrapping="Wrap" Text="{Binding Manufacturer, StringFormat='Производитель: {0}'}"/>
            <TextBlock TextWrapping="Wrap" Text="{Binding Manufacturer, StringFormat='Поставщик: {0}'}"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock TextWrapping="Wrap" Text="{Binding Cost, StringFormat='Цена: {0}'}"
                    Foreground="Red"
                    TextDecorations="Strikethrough"
                    Visibility="{Binding HasSale}"/>
                <TextBlock Text="{Binding FinalCost, StringFormat=' {0}'}"/>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Text="Единица измерения: шт."/>
            <TextBlock TextWrapping="Wrap" Text="{Binding Quantity, StringFormat='Количество на складе: {0}'}"/>
        </StackPanel>

        <TextBlock TextWrapping="Wrap" Grid.Column="2" Text="{Binding Sale, StringFormat='Действующая скидка -{0}%'}" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>

    </Grid>
</UserControl>
