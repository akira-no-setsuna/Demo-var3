<Window x:Class="Demo_var3.Views.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_var3.Views"
        mc:Ignorable="d"
        Title="ProductWindow" Height="450" Width="800"
        MinHeight="450" MinWidth="800"
        Style="{StaticResource BaseWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="20" />
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Background="{StaticResource SecondBg}" Grid.Row="0" VerticalAlignment="Top" FlowDirection="RightToLeft">
            <Button Content="Выход" Click="ExitButton_Click"/>
            <Label x:Name="FullNameLabel"/>
        </DockPanel>

        <StackPanel Background="{StaticResource SecondBg}"  Grid.Row="1" x:Name="ToolsPanel" Height="20" VerticalAlignment="Top" FlowDirection="LeftToRight" Orientation="Horizontal">
            <TextBox x:Name="SearchTb" TextChanged="SearchTb_TextChanged" Width="200" Margin="10 0 0 0"/>
            <ComboBox x:Name="SortCb" SelectionChanged="SortCb_SelectionChanged" Width="200" Margin="10 0 0 0" SelectedIndex="0">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По возрастанию цены"/>
                <ComboBoxItem Content="По возрастанию количества"/>
                <ComboBoxItem Content="По возрастанию скидки"/>
                <ComboBoxItem Content="По убыванию цены"/>
                <ComboBoxItem Content="По убыванию количества"/>
                <ComboBoxItem Content="По убыванию скидки"/>
            </ComboBox>
            <ComboBox x:Name="FiltrationCb" SelectionChanged="FiltrationCb_SelectionChanged" Width="200" Margin="10 0 0 0" SelectedIndex="0">
                <ComboBoxItem Content="Все производители"/>
            </ComboBox>

        </StackPanel>

        <ListView x:Name="CardsContainer"  Grid.Row="2"
        HorizontalContentAlignment="Stretch" 
        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
        PreviewMouseLeftButtonDown="CardsContainer_MouseLeftButtonDown">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:ProductCard/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ListView>

    </Grid>
</Window>
