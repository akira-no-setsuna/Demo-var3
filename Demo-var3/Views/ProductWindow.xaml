<Window x:Class="Demo_var3.Views.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo_var3.Views"
        mc:Ignorable="d"
        Title="ProductWindow" Height="450" Width="800"
        Style="{StaticResource BaseWindow}">
    <StackPanel>
        <DockPanel Background="{StaticResource SecondBg}" Height="30" VerticalAlignment="Top" FlowDirection="RightToLeft">
            <Button Content="Выход" Click="ExitButton_Click"/>
            <Label x:Name="FullNameLabel"/>
        </DockPanel>

        <ListView x:Name="CardsContainer" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:ProductCard/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ListView>

    </StackPanel>
</Window>
