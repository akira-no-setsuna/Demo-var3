<Application x:Class="Demo_var3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Demo_var3"
             StartupUri="Views/Login.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="MainBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondBg" Color="#F5DEB3"/>
        <SolidColorBrush x:Key="Accent" Color="#DEB887"/>

        <Style x:Key="BaseWindow" TargetType="Window">
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Background" Value="{StaticResource MainBg}"/>
            <Setter Property="Icon" Value="/Resources/icon.ico"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Application.Resources>
</Application>
